PORT=1888

# Native panel reverse proxy on the same host: HOST=127.0.0.1.
# Container runtimes must listen on 0.0.0.0; restrict the published host port.
HOST=0.0.0.0

# panel:start and Docker set this automatically. Leave blank for sy installs.
PANELARK_DEPLOYMENT_MODE=

# Optional PanelArk runtime data directory. Defaults to ./data.
PANELARK_DATA_DIR=

# Optional one-time administrator setup token. When omitted, the first startup
# writes a generated token to the active data directory with restricted mode.
# One-click production installs use /var/lib/panelark/admin-setup-token.txt.
PANELARK_SETUP_TOKEN=

# Optional API protection. When set, a trusted reverse proxy must add either:
# Authorization: Bearer <token>
# X-App-Token: <token>
APP_AUTH_TOKEN=

# Optional HTTPS certificate paths for this assistant itself.
SSL_CERT=
SSL_KEY=

# Require HTTPS in production. Set PANELARK_TRUST_PROXY=true only when the
# application is behind a trusted reverse proxy that sets X-Forwarded-Proto.
PANELARK_REQUIRE_HTTPS=false
PANELARK_TRUST_PROXY=false

# Optional encrypted scheduled-backup password (minimum 12 characters).
# Keep this in the service environment, never in source control.
PANELARK_BACKUP_PASSPHRASE=

# Optional signed-update endpoints. Formal release packages embed the trusted
# Ed25519 public key as release-public-key.pem; use this variable only for
# controlled key rotation.
PANELARK_UPDATE_PUBLIC_KEY=
PANELARK_UPDATE_MANIFEST_URL=https://github.com/wstimin/xui-zhushou/releases/latest/download/release-manifest.json
PANELARK_BETA_MANIFEST_URL=https://github.com/wstimin/xui-zhushou/releases/download/beta/release-manifest.json

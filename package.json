{
  "name": "xui-zhushou",
  "private": true,
  "version": "2.1.1",
  "description": "PanelArk 面板方舟：面向多种 VPS 面板与工具的一键部署助手",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "package:release": "node scripts/create-release-package.mjs",
    "lint": "tsc --noEmit",
    "test": "tsx --test server/inbound-builder.test.ts server/panel-adapters.test.ts server/catalog-adapters.test.ts server/panelark-api.test.ts server/panelark-backup.test.ts server/panelark-update.test.ts server/panelark-jobs.test.ts server/panelark-remote.test.ts server/panelark-remote-api.test.ts server/ssh.test.ts server/validation.test.ts server/xray-template.test.ts server/xui-client.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.15.0",
    "ssh2": "^1.16.0",
    "undici": "^7.13.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sql.js": "^1.4.9",
    "@types/ssh2": "^1.15.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
